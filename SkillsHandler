local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local ServerRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ServerRemote")
local ReplicateRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Replicate")
local SkillSets = require(ReplicatedStorage:WaitForChild("SkillSets"))

local AvailabilityChecks = require(ServerScriptService:WaitForChild("Modules"):WaitForChild("AvailablitiyChecks"))
local CooldownManager = require(ServerScriptService:WaitForChild("Modules"):WaitForChild("CooldownManager"))

local LoadedModules = {}

local function FindSkillModule(key)
	if LoadedModules[key] then
		return LoadedModules[key]
	end

	local folder = ServerScriptService:WaitForChild("Skills"):FindFirstChild(key)
	local serverModule = folder and folder:FindFirstChild("ServerModule")
	if serverModule and serverModule:IsA("ModuleScript") then
		LoadedModules[key] = require(serverModule)
		return LoadedModules[key]
	end

	warn("[SkillsHandler] no ServerModule for:", key)
	return nil
end

local function Validate(player, param, extra)
	local character = player.Character
	if not character then
		return false, "no character"
	end
	
	if param.Key == "WaterGun" and param.Function == "Target" then
		return true
	end

	if not extra or extra.state ~= "Begin" then
		return true
	end

	if AvailabilityChecks.Check(character) then
		return false, "availability check failed"
	end
	if CooldownManager:IsOnCooldown(player, param.Key) then
		return false, "on cooldown"
	end
	if character:GetAttribute("Locked") then
		return false, "Locked"
	end
	if character:GetAttribute("Stunned") then
		return false, "Stunned"
	end
	if character:GetAttribute("Frozen") then
		return false, "Frozen"
	end

	local equipped = character:GetAttribute("EquippedWeapon")
	if equipped ~= param.Key then
		return false, "weapon not equipped"
	end

	local binds = SkillSets.WeaponBinds[equipped]
	if not binds then
		return false, "no binds for weapon"
	end

	for _, data in pairs(binds) do
		if data.Key == param.Key then
			return true
		end
	end

	return false, "skill not valid for weapon"
end

ServerRemote.OnServerEvent:Connect(function(player, param, extra)
	if typeof(param) ~= "table" or typeof(param.Key) ~= "string" or typeof(param.Function) ~= "string" then
		return
	end

	local ok, reason = Validate(player, param, extra)
	if not ok then
		warn("[SkillsHandler] Rejected", param.Key, "from", player.Name, "—", reason)
		return
	end

	local skillModule = FindSkillModule(param.Key)
	local func = skillModule and skillModule[param.Function]
	if typeof(func) == "function" then
		func(player, extra or {}, ReplicateRemote)
	end
end)


-------------------------- CooldownManager --------------------------
(ModuleScript, ServerScriptService.Modules)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ReplicateRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Replicate")

local CooldownManager = {}
CooldownManager.PlayerCooldowns = {}

local function getCharacter(Player)
	return Player:IsA("Player") and Player.Character or nil
end

local function getMultiplier(character)
	return (character and character:GetAttribute("CooldownMultiplier")) or 1
end


local function getTable(Player)
	if not CooldownManager.PlayerCooldowns[Player] then
		CooldownManager.PlayerCooldowns[Player] = {}
	end
	return CooldownManager.PlayerCooldowns[Player]
end

function CooldownManager:IsOnCooldown(Player, key)
	local t = getTable(Player)
	local data = t[key]
	if not data then return false end

	if tick() >= data.EndTime then
		t[key] = nil
		ReplicateRemote:FireClient(Player, {Key = key, Function = "StopCooldown"})
		return false
	end

	return true
end

function CooldownManager:GetRemaining(Player, key)
	local t    = getTable(Player)
	local data = t[key]
	if not data then return 0 end

	local remaining = data.EndTime - tick()
	if remaining <= 0 then
		t[key] = nil
		ReplicateRemote:FireClient(Player, {Key = key, Function = "StopCooldown"})
		return 0
	end

	return remaining
end

function CooldownManager:Start(Player, key, baseCooldown)
	local char = getCharacter(Player)
	local multiplier = getMultiplier(char)
	local total = math.max(baseCooldown * multiplier, 0.001)
	local t = getTable(Player)

	t[key] = {
		Key = key,
		StartTime = tick(),
		BaseCooldown = baseCooldown,
		Multiplier = multiplier,
		EndTime = tick() + total,
	}

	ReplicateRemote:FireClient(Player, {
		Key = key,
		Function = "StartCooldown",
		EndTime = t[key].EndTime,
		Duration = total,
	})

	return total
end

function CooldownManager:Stop(Player, key)
	local t = getTable(Player)
	t[key] = nil
	ReplicateRemote:FireClient(Player, {Key = key, Function = "StopCooldown"})
end

function CooldownManager:ReduceRemaining(Player, key, amount)
	local t = getTable(Player)
	local data = t[key]
	if not data then return end

	data.EndTime = math.max(tick(), data.EndTime - amount)
	if data.EndTime <= tick() then
		t[key] = nil
		ReplicateRemote:FireClient(Player, {Key = key, Function = "StopCooldown"})
		return
	end

	ReplicateRemote:FireClient(Player, {
		Key = key,
		Function = "UpdateCooldown",
		EndTime = data.EndTime,
		Duration = math.max(0, data.EndTime - tick()),
	})
end

function CooldownManager:SetMultiplier(Player, value)
	local character = getCharacter(Player)
	if not character then return end
	character:SetAttribute("CooldownMultiplier", value)
	local t = getTable(Player)
	local newMult = value
	for key, data in pairs(t) do
		local oldTotal = data.BaseCooldown * data.Multiplier
		local elapsed = tick() - data.StartTime
		local progress = math.clamp(elapsed / math.max(oldTotal, 0.001), 0, 1)
		local newTotal = math.max(data.BaseCooldown * newMult, 0.001)
		local newRemaining = newTotal * (1 - progress)
		if newRemaining <= 0 then
			t[key] = nil
			ReplicateRemote:FireClient(Player, {Key = key, Function = "StopCooldown"})
		else
			data.Multiplier = newMult
			data.EndTime    = tick() + newRemaining
			ReplicateRemote:FireClient(Player, {
				Key = key,
				Function = "UpdateCooldown",
				EndTime = data.EndTime,
				Duration = newRemaining,
			})
		end
	end
end

function CooldownManager:ClearPlayer(Player)
	CooldownManager.PlayerCooldowns[Player] = nil
end

Players.PlayerRemoving:Connect(function(Player)
	CooldownManager:ClearPlayer(Player)
end)

return CooldownManager


------------------------- AvailabilityChecks ------------------------
(ModuleScript, ServerScriptService.Modules)

local module = {}

module.Check = function(character)
	local checks = {
		Stunned = character:GetAttribute("Stunned") == true,
		SkillDebounce = character:GetAttribute("SkillDebounce") == true,
		UsingSkill = character:GetAttribute("UsingSkill") == true,
		Locked = character:GetAttribute("Locked") == true,
	}

	for _, blocked in pairs(checks) do
		if blocked then return true end
	end

	return false
end

return module
