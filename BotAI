--!strict

local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

type SpawnSet = {[BasePart]: boolean}
type Arena = {alive: Folder, dead: Folder?, kill: BasePart?, rays: RaycastParams}
type Bot = {
	model: Model,
	root: BasePart,
	humanoid: Humanoid,
	arena: Arena,
	round: boolean,
	rng: Random,
	face: AlignOrientation,
	attachment: Attachment,
	idle: AnimationTrack,
	shoot: AnimationTrack,
	connections: {RBXScriptConnection},
	nextMove: number,
	nextShot: number,
	nextJump: number,
	doubleJump: boolean,
	active: boolean,
}

local moduleFolder = script.Parent
assert(moduleFolder, "BotService must have a parent")
local ShootModule = require(moduleFolder:WaitForChild("ShootModule")) :: {
	BotFire: (Model, Vector3) -> boolean,
} -- The adapter describes the existing weapon contract without importing its implementation.
local CONFIG = table.freeze({
	minimumFighters = 3,
	maximumBots = 3,
	thinkInterval = 0.16,
	moveInterval = 0.6,
	shotCooldown = 1.3,
	jumpCooldown = 0.45,
	attackRange = 240,
	maximumRise = 10,
	maximumDrop = 5,
	maximumGap = 7,
}) -- freezing values stops one arena from changing another's
local bots: {[Model]: Bot} = {}
local BotService = {}

local function requireFolder(parent: Instance, name: string): Folder
	local child = parent:WaitForChild(name) -- hirarchy errors at startup before a match
	assert(child:IsA("Folder"), name .. " must be a Folder")
	return child
end

local function rootOf(model: Model): BasePart?
	local root = model:FindFirstChild("HumanoidRootPart") -- PrimaryPart can be a weapon, so use the character root.
	return if root and root:IsA("BasePart") then root else nil
end

local function createArena(parent: Instance, dead: Folder?): Arena
	local candidate = parent:FindFirstChild("KillForceField") or Workspace:FindFirstChild("KillForceField")
	local rays = RaycastParams.new() -- cache query objects rather than one for every floor sample.
	rays.FilterType = Enum.RaycastFilterType.Exclude
	rays.RespectCanCollide = true -- effects and noncollidable must not count as walkable floor.
	return {
		alive = requireFolder(parent, "Alive"),
		dead = dead,
		kill = if candidate and candidate:IsA("BasePart") then candidate else nil,
		rays = rays,
	}
end

local mainArena = createArena(Workspace, requireFolder(Workspace, "Dead"))
local testContainer = Workspace:FindFirstChild("Test") -- A practice arena is optional for a main-round-only demo.
local testArena: Arena? = if testContainer then createArena(testContainer, nil) else nil
local arenas: {Arena} = {mainArena}
if testArena then
	table.insert(arenas, testArena)
end
local animations = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Animations"):WaitForChild("LazerGun")

local function refreshFilters(): ()
	local excluded: {Instance} = {}
	for _, arena in arenas do
		table.insert(excluded, arena.alive)
		if arena.dead then
			table.insert(excluded, arena.dead)
		end
		if arena.kill then
			table.insert(excluded, arena.kill) -- kill plane is a boundary, not a valid landing platform
		end
	end
	for _, name in {"Fx", "Bullets"} do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			table.insert(excluded, folder)
		end
	end
	for _, arena in arenas do
		arena.rays.FilterDescendantsInstances = excluded
	end
end

local function isAlive(model: Model, arena: Arena): boolean
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return model.Parent == arena.alive and humanoid ~= nil and humanoid.Health > 0 and rootOf(model) ~= nil
end

local function fightersIn(arena: Arena): {Model}
	local fighters: {Model} = {}
	for _, child in arena.alive:GetChildren() do
		if child:IsA("Model") and isAlive(child, arena) then
			table.insert(fighters, child)
		end
	end
	return fighters
end

local function floorAt(position: Vector3, arena: Arena, raised: boolean): RaycastResult?
	local height = if raised then CONFIG.maximumRise + 4 else 2
	local hit = Workspace:Raycast(position + Vector3.yAxis * height, -Vector3.yAxis * (height + 14), arena.rays)
	if not hit or hit.Normal.Y < 0.6 then
		return nil -- walls and slopes too steep to be landing surfaces
	end
	local kill = arena.kill
	if kill and hit.Position.Y <= kill.Position.Y + kill.Size.Y * 0.5 + 1 then
		return nil -- compae against the planes top so bots cannot select the floor underneath the arena
	end
	return hit
end

local function navigable(position: Vector3, floorY: number, arena: Arena): RaycastResult?
	local hit = floorAt(position, arena, true)
	if not hit then
		return nil
	end
	local difference = hit.Position.Y - floorY -- Signed height distinguishes a jumpable rise from a dangerous drop.
	return if difference >= -CONFIG.maximumDrop and difference <= CONFIG.maximumRise then hit else nil
end

local function safeRoute(origin: Vector3, goal: Vector3, floorY: number, arena: Arena): (boolean, boolean)
	local offset = Vector3.new(goal.X - origin.X, 0, goal.Z - origin.Z) -- ignores the targets jump height
	local length = offset.Magnitude
	if length < 0.1 then
		return true, false
	end
	local samples = math.ceil(length)
	local gapLength, needsJump = 0, false
	for index = 1, samples do
		local sample = origin + offset * (index / samples)
		local hit = navigable(sample, floorY, arena)
		if hit then
			needsJump = needsJump or gapLength > 0 or hit.Position.Y > floorY + 0.5
			gapLength = 0 -- valid landing surface ends the current gap rather than extending its running total
		else
			gapLength += length / samples
			if gapLength > CONFIG.maximumGap then
				return false, false -- the reject candidate before movement into a void.
			end
		end
	end
	return gapLength == 0, needsJump -- short gap is still unsafe if the route ends without a landing
end

local function nearest(data: Bot, fighters: {Model}): (BasePart?, number)
	local target: BasePart? = nil
	local distanceSquared = math.huge
	for _, fighter in fighters do
		local root = rootOf(fighter)
		if fighter ~= data.model and root then
			local offset = root.Position - data.root.Position
			local squared = offset.X * offset.X + offset.Z * offset.Z -- roots are needed only for the winner
			if squared < distanceSquared then
				target, distanceSquared = root, squared
			end
		end
	end
	return target, math.sqrt(distanceSquared)
end

local function moveSafely(data: Bot, enemy: BasePart, now: number): ()
	if now < data.nextMove then
		return -- decisions are slower than aiming so floor probes stay bounded.
	end
	data.nextMove = now + CONFIG.moveInterval + data.rng:NextNumber(0, 0.2)
	local floor = floorAt(data.root.Position, data.arena, false)
	if not floor then
		return -- airborne bots keep their existing momentum until a landing
	end
	local offset = enemy.Position - data.root.Position
	local forward = Vector3.new(offset.X, 0, offset.Z)
	forward = if forward.Magnitude > 0.1 then forward.Unit else Vector3.zAxis
	local side = Vector3.new(-forward.Z, 0, forward.X) -- rotating the planar vector creates strafes
	local directions = {side, -side, -forward, (side - forward).Unit, (-side - forward).Unit, forward}
	for index = #directions, 2, -1 do
		local other = data.rng:NextInteger(1, index)
		directions[index], directions[other] = directions[other], directions[index] -- avoids biased sorting.
	end
	for _, direction in directions do
		local goal = data.root.Position + direction * data.rng:NextNumber(7, 13)
		if not navigable(goal, floor.Position.Y, data.arena) then
			continue -- Endpoint rejection saves the more expensive route scan.
		end
		local safe, needsJump = safeRoute(data.root.Position, goal, floor.Position.Y, data.arena)
		if safe then
			data.humanoid:MoveTo(goal)
			if needsJump and now >= data.nextJump and data.humanoid.FloorMaterial ~= Enum.Material.Air then
				data.nextJump = now + CONFIG.jumpCooldown
				data.humanoid.Jump = true -- Humanoid owns normal grounded jumps; the extra jump is handled below.
			end
			return -- The first safe shuffled option supplies varied movement without probing every route.
		end
	end
	data.humanoid:Move(Vector3.zero) -- the previous MoveTo when terrain destruction removes every safe option
end

local function disconnectBot(data: Bot): ()
	data.active = false -- Disable state first so reentrant death or destruction signals become harmless.
	for _, connection in data.connections do
		connection:Disconnect()
	end
	table.clear(data.connections)
	data.idle:Stop(0)
	data.shoot:Stop(0)
	data.idle:Destroy()
	data.shoot:Destroy()
	bots[data.model] = nil -- Removing the key releases
end

local function destroyBot(data: Bot): ()
	if data.active then
		disconnectBot(data)
	end
	data.model:Destroy() -- Disconnect first must not try to clean the same animation tracks twice.
end

local function equip(model: Model, root: BasePart): boolean
	local template = ServerStorage:WaitForChild("Weapons"):FindFirstChild("LazerGun")
	local arm = model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm") -- Support both rig
	if not template or not template:IsA("Model") or not arm or not arm:IsA("BasePart") then
		return false
	end
	local gun = template:Clone()
	local primary = gun.PrimaryPart
	if not primary then
		gun:Destroy()
		return false -- motor6D cannot attach a model with no designated handle
	end
	gun:PivotTo(root.CFrame)
	gun:SetAttribute("Weapon", true) -- cleanup removes only owned weapon models
	gun.Parent = model
	local motor = Instance.new("Motor6D")
	motor.Name, motor.Part0, motor.Part1 = "WeaponMotor", arm, primary
	local motors = ServerStorage:FindFirstChild("Motors")
	local source = if motors then motors:FindFirstChild("LazerGun") else nil
	if source and source:IsA("Motor6D") then
		motor.C0, motor.C1 = source.C0, source.C1 -- keep the authored grip rather than inventing an offset
	end
	motor.Parent = primary
	model:SetAttribute("EquippedWeapon", "LazerGun")
	return true
end

local function spawnBot(arena: Arena, round: boolean, points: {BasePart}, used: SpawnSet): Model?
	local available: {BasePart} = {}
	for _, point in points do
		if point.Parent and not used[point] then
			table.insert(available, point)
		end
	end
	if #available == 0 then
		for _, point in points do
			if point.Parent then
				table.insert(available, point) -- spawn only after every live marker has been used
			end
		end
	end
	if #available == 0 then
		return nil
	end
	local template = ServerStorage:WaitForChild("BotTemplate")
	assert(template:IsA("Model"), "BotTemplate must be a Model")
	local model = template:Clone()
	local root, humanoid = rootOf(model), model:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or not equip(model, root) then
		model:Destroy()
		return nil
	end
	local rng = Random.new()
	local point = available[rng:NextInteger(1, #available)]
	used[point] = true
	model.Name = if round then "Spleef Bot" else "Test Bot"
	model:SetAttribute("IsBot", true)
	model:SetAttribute("Locked", round)
	model:SetAttribute("RoundBot", round)
	model:PivotTo(point.CFrame * CFrame.new(0, 3, 0)) -- offset follows a rotated spawns orientation
	model.Parent = arena.alive
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and not descendant.Anchored then
			local canSet = descendant:CanSetNetworkOwnership()
			if canSet then
				descendant:SetNetworkOwner(nil)
			end
		end
	end
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local face = Instance.new("AlignOrientation")
	face.Mode, face.Attachment0 = Enum.OrientationAlignmentMode.OneAttachment, attachment
	face.MaxTorque, face.Responsiveness = 100000, 25
	face.CFrame, face.Parent = root.CFrame.Rotation, root -- orientation avoids a snap toward world zero
	humanoid.AutoRotate = false -- steering owns yaw so Humanoid cant fight the orientation
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = humanoid
	local idleAnimation, shootAnimation = animations:WaitForChild("Idle"), animations:WaitForChild("Shoot")
	assert(idleAnimation:IsA("Animation") and shootAnimation:IsA("Animation"), "Invalid bot animations")
	local idle, shoot = animator:LoadAnimation(idleAnimation), animator:LoadAnimation(shootAnimation)
	idle.Looped, idle.Priority, shoot.Priority = true, Enum.AnimationPriority.Idle, Enum.AnimationPriority.Action
	idle:Play(0.1) -- action track overrides idle while firing eliminating delayed animation reset tasks
	local data: Bot = {
		model = model, root = root, humanoid = humanoid, arena = arena, round = round, rng = rng,
		face = face, attachment = attachment, idle = idle, shoot = shoot, connections = {},
		nextMove = 0, nextShot = 0, nextJump = 0, doubleJump = true, active = true,
	}
	bots[model] = data
	table.insert(data.connections, humanoid.Died:Connect(function(): ()
		if not data.active then
			return
		end
		disconnectBot(data)
		face:Destroy()
		attachment:Destroy()
		if arena.dead then
			model.Parent = arena.dead -- removes the corpse from the rounds competitor
		else
			model:Destroy()
		end
		Debris:AddItem(model, 4)
	end))
	table.insert(data.connections, model.Destroying:Connect(function(): ()
		if data.active then
			disconnectBot(data) -- map resets receive the same cleanup as normal death
		end
	end))
	return model
end

local function think(data: Bot, fighters: {Model}, now: number): ()
	if data.model:GetAttribute("Locked") == true then
		data.humanoid:Move(Vector3.zero)
		return
	end
	if data.humanoid.FloorMaterial ~= Enum.Material.Air then
		data.doubleJump = true -- replenishes exactly one extra air jump
	elseif data.doubleJump and data.root.AssemblyLinearVelocity.Y < -3 then
		data.doubleJump = false
		local speed = if data.humanoid.UseJumpPower then data.humanoid.JumpPower
			else math.sqrt(2 * Workspace.Gravity * data.humanoid.JumpHeight)
		local change = math.max(0, speed - data.root.AssemblyLinearVelocity.Y)
		data.root:ApplyImpulse(Vector3.yAxis * change * data.root.AssemblyMass)
	end
	local enemy, distance = nearest(data, fighters)
	if not enemy then
		data.humanoid:Move(Vector3.zero)
		return
	end
	moveSafely(data, enemy, now)
	local flatTarget = Vector3.new(enemy.Position.X, data.root.Position.Y, enemy.Position.Z)
	if (flatTarget - data.root.Position).Magnitude > 0.1 then
		data.face.CFrame = CFrame.lookAt(data.root.Position, flatTarget).Rotation -- preserves an upright rig
	end
	if distance > CONFIG.attackRange or now < data.nextShot then
		return
	end
	data.nextShot = now + CONFIG.shotCooldown -- before calling weapon code so failed requests cant spam it
	local targetFloor = floorAt(enemy.Position, data.arena, false)
	if targetFloor then
		local spread = Vector3.new(data.rng:NextNumber(-2.5, 2.5), 0, data.rng:NextNumber(-2.5, 2.5))
		if ShootModule.BotFire(data.model, targetFloor.Position + spread) then
			data.shoot:Play(0.05)
		end
	end
end

function BotService.SpawnForRound(_self: unknown, points: {BasePart}, used: SpawnSet): ()
	local needed = math.clamp(CONFIG.minimumFighters - #fightersIn(mainArena), 0, CONFIG.maximumBots)
	for _ = 1, needed do
		spawnBot(mainArena, true, points, used) -- enrolled fighters not players who in the practice arena
	end
end

function BotService.SpawnTestBot(_self: unknown, points: {BasePart}, used: SpawnSet): Model?
	return if testArena then spawnBot(testArena, false, points, used) else nil
end

function BotService.SpawnTestBots(_self: unknown, points: {BasePart}, used: SpawnSet, minimum: number?): {Model}
	local spawned: {Model} = {}
	if testArena then
		local needed = math.clamp((minimum or CONFIG.minimumFighters) - #fightersIn(testArena), 0, CONFIG.maximumBots)
		for _ = 1, needed do
			local model = spawnBot(testArena, false, points, used)
			if model then
				table.insert(spawned, model)
			end
		end
	end
	return spawned
end

function BotService.UnlockRoundBots(_self: unknown): ()
	for model, data in bots do
		if data.round then
			model:SetAttribute("Locked", false) -- unlocking twice does not create duplicate brains
		end
	end
end

local function endBots(round: boolean): ()
	local retiring: {Bot} = {}
	for _, data in bots do
		if data.round == round then
			table.insert(retiring, data) --snapshot first
		end
	end
	for _, data in retiring do
		destroyBot(data)
	end
end

function BotService.EndRound(_self: unknown): ()
	endBots(true)
end

function BotService.EndTestBots(_self: unknown): ()
	endBots(false)
end

local accumulator = 0
local updating = false
for _, arena in arenas do
	if arena.kill then
		arena.kill.Touched:Connect(function(hit: BasePart): ()
			local ancestor: Instance? = hit
			while ancestor and ancestor ~= Workspace do
				local data = if ancestor:IsA("Model") then bots[ancestor] else nil
				if data and data.arena == arena then
					data.humanoid.Health = 0 -- arena listener replaces one kill connection per bot
					return
				end
				ancestor = ancestor.Parent
			end
		end)
	end
end
RunService.Heartbeat:Connect(function(dt: number): ()
	accumulator += dt
	if updating or accumulator < CONFIG.thinkInterval or next(bots) == nil then
		return
	end
	updating = true -- Prevent overlapping ticks if the existing BotFire dependency yields internally.
	accumulator %= CONFIG.thinkInterval -- Drop work rather than executing a burst of stale decisions
	refreshFilters()
	local snapshots: {[Arena]: {Model}} = {}
	for _, arena in arenas do
		snapshots[arena] = fightersIn(arena)
	end
	local now = os.clock() -- one timestamp gives every bot the same cooldown this tick
	local pending: {Bot} = {}
	for _, data in bots do
		table.insert(pending, data)
	end
	for _, data in pending do
		if data.active and isAlive(data.model, data.arena) then
			local ok, reason = pcall(function(): nil
				think(data, snapshots[data.arena], now)
				return nil
			end)
			if not ok then
				warn("Bot retired after weapon/AI error:", reason)
				destroyBot(data)
			end
		elseif data.active then
			destroyBot(data)
		end
	end
	updating = false
end)

return BotService
