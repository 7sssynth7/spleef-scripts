-- slot machine style text that slows down and lands on the chosen event
local function cycleEventText(label, events, chosenEvent)
	local ticks = 20
	for i = 1, ticks do
		label.Text = events[math.random(1, #events)].Name
		local progress = i / ticks
		task.wait(0.04 + (progress ^ 3) * 0.45)
	end
	label.Text = chosenEvent.Name
end

local function tweenEventBg(randBg, events, chosenEvent)
	local ti = TweenInfo.new(.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	randBg.Visible = true
	randBg.Sep.UIGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 1),
		NumberSequenceKeypoint.new(1, 1)
	})
	randBg.RandomEvent.TextTransparency = 1
	randBg.RandEventTitle.Transparency = 1

	-- tween a NumberValue so the gradient can follow it
	local proxy = Instance.new("NumberValue")
	proxy.Value = 0

	local tween = ts:Create(proxy, ti, {Value = 1})
	proxy:GetPropertyChangedSignal("Value"):Connect(function()
		randBg.Sep.UIGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, proxy.Value),
			NumberSequenceKeypoint.new(1, 1)
		})
	end)

	tween:Play()
	tween.Completed:Connect(function()
		proxy:Destroy()
	end)

	ts:Create(randBg.RandEventTitle, ti, {TextTransparency = 0}):Play()
	ts:Create(randBg.RandomEvent, ti, {TextTransparency = 0}):Play()

	cycleEventText(randBg.RandomEvent, events, chosenEvent)
end

local function showMapAndEvent(ChosenMap, chosen, listOfEvents)
	for _, player in pairs(Players:GetPlayers()) do
		if not isLobbyPlayer(player) then
			continue
		end

		task.spawn(function()
			player.PlayerGui.PlayerUIs.NotisBg.Visible = false

			local mvGUI = player.PlayerGui.MapVote
			local MapWinBg = mvGUI.MapWinBg
			local WinnerTemp = MapWinBg.WinnerTemp
			local RandBg = MapWinBg.Randbg

			MapWinBg.Visible = true
			WinnerTemp.Visible = true
			WinnerTemp.Position = UDim2.fromScale(.5, .5)

			local ogSize = MapWinBg.Size
			MapWinBg.Size = UDim2.fromScale(.1, .35)

			ts:Create(MapWinBg, TweenInfo.new(.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = ogSize}):Play()

			if ChosenMap.Parent:GetAttribute("Image") then
				WinnerTemp.MapImage.Image = "rbxassetid://" .. ChosenMap.Parent:GetAttribute("Image")
			end

			WinnerTemp.MapName.Text = ChosenMap.Name
			task.wait(3)

			local tweenTempOff = ts:Create(WinnerTemp, TweenInfo.new(.1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.fromScale(.1, .35)})
			tweenTempOff:Play()
			tweenTempOff.Completed:Connect(function()
				WinnerTemp.Visible = false
			end)

			tweenEventBg(RandBg, listOfEvents, chosen)
		end)
	end

	task.wait(10)

	for _, player in pairs(Players:GetPlayers()) do
		local mvGUI = player.PlayerGui.MapVote
		mvGUI.MapWinBg.Visible = false

		for _, button in pairs(mvGUI.bg.Container:GetChildren()) do
			if button:IsA("GuiButton") then
				button:Destroy()
			end
		end
	end
end

