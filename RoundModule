--!strict

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local CollectionService = game:GetService("CollectionService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")
local modules = ServerScriptService:WaitForChild("Modules")
local moduleFolder = script.Parent
assert(moduleFolder, "RoundModule must have a parent")
local MapVote = require(moduleFolder:WaitForChild("MapVoteController"))
local BotService = require(modules:WaitForChild("BotService"))
local Events = require(modules:WaitForChild("EventsModule"))
local Cooldowns = require(modules:WaitForChild("CooldownManager"))
local Rewards = require(modules:WaitForChild("RewardStats")) :: {
	GiveExp: (Player, number) -> (), GiveWin: (Player, number) -> (), GiveCash: (Player, number) -> (),
	CalcLoseExp: (Player) -> number, CalcWinExp: (Player) -> number,
}
local Skins = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("SkinsInfo")) :: {
	Skins: {[string]: {Icon: string}},
}
local alive, dead = Workspace:WaitForChild("Alive"), Workspace:WaitForChild("Dead")
local mapFolder, fxFolder = Workspace:WaitForChild("Map"), Workspace:WaitForChild("Fx")
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local music, roundRemote = remotes:WaitForChild("Music") :: RemoteEvent, remotes:WaitForChild("RS") :: RemoteEvent
local weapons, assets = ServerStorage:WaitForChild("Weapons"), ReplicatedStorage:WaitForChild("Assets")
type Phase = "Idle" | "Voting" | "Preparing" | "Active" | "Ending"
type Snapshot = {Kills: number, Cash: number, Exp: number, TotalExp: number, Level: number}
type Entrant = {character: Model, player: Player?, humanoid: Humanoid, root: BasePart, alive: boolean, awardedExp: number}
type Stop = () -> ()
local phase: Phase = "Idle"
local function currentPhase(): Phase
	return phase -- read the current phase because callbacks can change it
end
local generation = 0
local contestants: {[Model]: Entrant} = {}
local connections: {RBXScriptConnection} = {}
local rng = Random.new()
local Round = {
	IntermissionTime = 20, RoundTime = 150, VoteTime = 10,
	RoundWinner = nil :: (Player | Model)?, RoundActive = false, CanVote = false,
	StatsInfo = {} :: {[string]: Snapshot}, ActiveEventStop = nil :: Stop?, ActiveLavaStop = nil :: Stop?,
}

local function rootOf(character: Model): BasePart?
	local root = character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function descendant(parent: Instance?, path: {string}): Instance?
	local current = parent
	for _, name in path do
		current = if current then current:FindFirstChild(name) else nil
	end
	return current
end

local function ui(player: Player, path: {string}): Instance?
	return descendant(player:FindFirstChildOfClass("PlayerGui"), path)
end

local function text(instance: Instance?, value: string): ()
	if instance and instance:IsA("TextLabel") then
		instance.Text = value
	elseif instance and instance:IsA("TextButton") then
		instance.Text = value
	end
end

local function visible(instance: Instance?, value: boolean): ()
	if instance and instance:IsA("GuiObject") then
		instance.Visible = value
	end
end

local function notice(value: string): ()
	for _, player in Players:GetPlayers() do
		visible(ui(player, {"PlayerUIs", "NotisBg"}), true)
		text(ui(player, {"PlayerUIs", "NotisBg", "bg", "NoticeText"}), value)
	end
end

local function numberAt(player: Player, path: {string}): number
	local instance = descendant(player, path)
	if instance and instance:IsA("IntValue") then
		return instance.Value
	elseif instance and instance:IsA("NumberValue") then
		return instance.Value
	end
	return 0
end

local function snapshot(player: Player): Snapshot
	return {
		Kills = numberAt(player, {"leaderstats", "Kills"}), Cash = numberAt(player, {"leaderstats", "Cash"}),
		Exp = numberAt(player, {"Config", "Exp"}), TotalExp = numberAt(player, {"Config", "MaxExp"}),
		Level = numberAt(player, {"Config", "Level"}),
	}
end

local function inPractice(character: Model): boolean
	local practice = descendant(Workspace, {"Test", "Alive"})
	return practice ~= nil and character:IsDescendantOf(practice)
end

local function disconnectAll(): ()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
end

local function giveExperience(entry: Entrant, amount: number): ()
	local player = entry.player
	if player and player.Parent == Players then
		Rewards.GiveExp(player, amount)
		entry.awardedExp += amount -- track the XP actually given so level-ups do not change the result
	end
end

local function killFeed(character: Model): ()
	local template = script:FindFirstChild("FeedTemplate")
	if not template then
		return
	end
	for _, player in Players:GetPlayers() do
		local container = ui(player, {"KillFeed", "FeedBg"})
		if container then
			local clone = template:Clone()
			text(clone:FindFirstChild("TextLabel"), character.Name .. " died to " .. tostring(character:GetAttribute("Died") or "Void") .. "!")
			clone.Parent = container
			Debris:AddItem(clone, 3)
		end
	end
end

local function eliminate(entry: Entrant, award: boolean): ()
	if not entry.alive then
		return
	end
	entry.alive = false -- mark them out first so another signal cannot reward the same death
	entry.character:SetAttribute("Locked", true)
	if entry.character.Parent == alive then
		entry.character.Parent = dead
	end
	if award and entry.player and entry.player.Parent == Players then
		giveExperience(entry, Rewards.CalcLoseExp(entry.player))
		killFeed(entry.character)
	end
end

local function register(character: Model, player: Player?, token: number): ()
	local humanoid, root = character:FindFirstChildOfClass("Humanoid"), rootOf(character)
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	local entry: Entrant = {character = character, player = player, humanoid = humanoid, root = root, alive = true, awardedExp = 0}
	contestants[character] = entry
	table.insert(connections, humanoid.Died:Connect(function(): ()
		if generation == token then
			eliminate(entry, phase == "Active") -- deaths during the countdown do not give loss XP
		end
	end))
end

local function survivors(): {Entrant}
	local result: {Entrant} = {}
	for _, entry in contestants do
		if entry.alive then
			if entry.humanoid.Health <= 0 or entry.character.Parent ~= alive or not entry.root.Parent
				or (entry.player ~= nil and entry.player.Character ~= entry.character) then
				eliminate(entry, phase == "Active")
			else
				table.insert(result, entry)
			end
		end
	end
	return result -- count living entrants, not every object inside Alive
end

local function clearWeapons(character: Model): ()
	for _, child in character:GetChildren() do
		if child:IsA("Model") and child:GetAttribute("Weapon") == true then
			child:Destroy()
		end
	end
	character:SetAttribute("EquippedWeapon", nil)
end

local function applySkin(player: Player, gun: Model): ()
	local skins = player:FindFirstChild("Skins")
	if not skins then
		return
	end
	for _, owned in skins:GetChildren() do
		local activeSkin = owned:FindFirstChild("Active")
		local info = Skins.Skins[owned.Name]
		if not activeSkin or not activeSkin:IsA("BoolValue") or not activeSkin.Value or not info or owned.Name == "Default" then
			continue
		end
		local mesh = gun:FindFirstChildWhichIsA("SpecialMesh", true)
		if mesh then
			mesh.TextureId = info.Icon
		else
			for _, part in gun:GetDescendants() do
				if part:IsA("BasePart") and part.Transparency < 1 then
					for _, face in Enum.NormalId:GetEnumItems() do
						local decal = Instance.new("Decal")
						decal.Face, decal.Texture, decal.Parent = face, info.Icon, part
					end
				end
			end
		end
		local auraTemplate = descendant(assets, {"Fx", "Skins", owned.Name, "Aura"})
		local point = gun:FindFirstChild("Point")
		if auraTemplate and auraTemplate:IsA("Model") and point and point:IsA("BasePart") then
			local aura = auraTemplate:Clone()
			local primary = aura.PrimaryPart
			if primary then
				local size, auraSize = gun:GetExtentsSize(), aura:GetExtentsSize()
				local scale = math.max(size.X, size.Y, size.Z) / math.max(0.01, auraSize.X, auraSize.Y, auraSize.Z)
				aura:ScaleTo(scale)
				aura:PivotTo(point.CFrame)
				aura.Parent = gun
				for _, part in aura:GetDescendants() do
					if part:IsA("BasePart") then
						part.Anchored, part.CanCollide, part.Massless = false, false, true
					end
				end
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1, weld.Parent = point, primary, primary
			else
				aura:Destroy()
			end
		end
		return -- only apply the first active skin so auras cannot stack
	end
end

local function equip(player: Player, character: Model, root: BasePart): boolean
	local chosen, inventory = player:FindFirstChild("ActiveGun"), player:FindFirstChild("Inventory")
	local arm = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not chosen or not chosen:IsA("StringValue") or not inventory or not inventory:FindFirstChild(chosen.Value)
		or not arm or not arm:IsA("BasePart") then
		return false
	end
	local template = weapons:FindFirstChild(chosen.Value)
	if not template or not template:IsA("Model") then
		return false
	end
	local gun = template:Clone()
	local primary = gun.PrimaryPart
	if not primary then
		gun:Destroy()
		return false
	end
	clearWeapons(character)
	gun:SetAttribute("Weapon", true)
	gun:PivotTo(root.CFrame)
	gun.Parent = character
	for _, part in gun:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored, part.CanCollide, part.Massless = false, false, true -- the gun must not anchor the player or add extra mass
		end
	end
	local motor = Instance.new("Motor6D")
	motor.Name, motor.Part0, motor.Part1 = "WeaponMotor", arm, primary
	local source = descendant(ServerStorage, {"Motors", chosen.Value})
	if source and source:IsA("Motor6D") then
		motor.C0, motor.C1 = source.C0, source.C1
	end
	motor.Parent = primary
	character:SetAttribute("EquippedWeapon", chosen.Value)
	applySkin(player, gun)
	return true
end

local function cleanupMap(): ()
	local folders: {Instance} = {mapFolder, fxFolder}
	for _, name in {"Debris", "Bullets"} do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			table.insert(folders, folder)
		end
	end
	for _, folder in folders do
		if folder then
			for _, child in folder:GetChildren() do
				if child:GetAttribute("Arena") ~= "Test" then
					child:Destroy() -- keep effects marked for the practice arena
				end
			end
		end
	end
	local bulletsRemote = remotes:FindFirstChild("ReplicateBullets")
	if bulletsRemote and bulletsRemote:IsA("RemoteEvent") then
		bulletsRemote:FireAllClients(nil, "Cleanup")
	end
end

local function reportRewards(entry: Entrant): ()
	local player = entry.player
	if not player or player.Parent ~= Players then
		return
	end
	local previous = Round.StatsInfo[player.Name]
	if not previous then
		return
	end
	local current = snapshot(player)
	local base = ui(player, {"PlayerUIs", "RewardsBg", "RewardsContainer", "pat"})
	text(descendant(base, {"KillsTemp", "RewardText"}), "+" .. tostring(math.max(0, current.Kills - previous.Kills)))
	text(descendant(base, {"CashTemp", "RewardText"}), "+" .. tostring(math.max(0, current.Cash - previous.Cash)))
	text(descendant(base, {"ExpTemp", "RewardText"}), "+" .. tostring(entry.awardedExp))
	visible(ui(player, {"PlayerUIs", "RewardsBg"}), true)
end

local function announceMap(chosen: Model, eventName: string): ()
	for _, player in Players:GetPlayers() do
		if player.Character and player.Character.Parent == dead then
			visible(ui(player, {"PlayerUIs", "NotisBg"}), false)
			visible(ui(player, {"MapVote", "MapWinBg"}), true)
			visible(ui(player, {"MapVote", "MapWinBg", "WinnerTemp"}), true)
			visible(ui(player, {"MapVote", "MapWinBg", "Randbg"}), true)
			text(ui(player, {"MapVote", "MapWinBg", "WinnerTemp", "MapName"}), chosen.Name)
			text(ui(player, {"MapVote", "MapWinBg", "Randbg", "RandomEvent"}), eventName)
			local image = ui(player, {"MapVote", "MapWinBg", "WinnerTemp", "MapImage"})
			local metadata = chosen.Parent
			local id = if metadata then metadata:GetAttribute("Image") else nil
			if image and image:IsA("ImageLabel") and id then
				image.Image = "rbxassetid://" .. tostring(id)
			end
		end
	end
end

function Round.ValidVote(): boolean
	return phase == "Voting" and Round.CanVote
end

function Round.VoteStart(): Model?
	MapVote.Start()
	task.wait(Round.VoteTime)
	return MapVote.End()
end

function Round.RoundEnd(): ()
	if phase ~= "Active" and phase ~= "Preparing" then
		return
	end
	phase, Round.RoundActive = "Ending", false -- mark the round ended before calling code that might yield
	generation += 1
	disconnectAll()
	for _, stopper in {Round.ActiveEventStop, Round.ActiveLavaStop} do
		if stopper then
			local ok, reason = pcall(function(): nil
				stopper()
				return nil
			end)
			if not ok then
				warn("Round hazard cleanup failed:", reason)
			end
		end
	end
	Round.ActiveEventStop, Round.ActiveLavaStop = nil, nil
	local winner = Round.RoundWinner
	if winner then
		notice(winner.Name .. " won the round!")
		music:FireAllClients("winner")
		if winner:IsA("Player") and winner.Parent == Players then
			local character = winner.Character
			local entry = if character then contestants[character] else nil
			if entry then
				Rewards.GiveWin(winner, 1)
				giveExperience(entry, Rewards.CalcWinExp(winner))
				Rewards.GiveCash(winner, 500)
			end
			local rig = descendant(ServerScriptService, {"Scripts", "PlayWinner", "WonRig"})
			if rig then
				rig:SetAttribute("Winner", winner.Name) -- the winner display reads this attribute
			end
		end
	end
	local lobbySpawn = Workspace:FindFirstChild("LobbySpawn") or Workspace:FindFirstChildWhichIsA("SpawnLocation")
	for _, entry in contestants do
		local player, character = entry.player, entry.character
		if player and player.Parent == Players then
			reportRewards(entry)
			Cooldowns:ClearPlayer(player)
			roundRemote:FireClient(player, "RoundEnd")
			if character.Parent and player.Character == character then
				character.Parent = dead
				clearWeapons(character)
				for _, attribute in {"Locked", "UsingSkill", "SkillDebounce", "Stunned", "Frozen", "Slowed"} do
					character:SetAttribute(attribute, false) -- only reset combat flags so other attributes keep their values
				end
				character:SetAttribute("Count", nil)
				local highlight = character:FindFirstChild("GameHL")
				if highlight then
					highlight:Destroy()
				end
				entry.root.Anchored = false
				if lobbySpawn and lobbySpawn:IsA("BasePart") and entry.humanoid.Health > 0 then
					character:PivotTo(lobbySpawn.CFrame * CFrame.new(0, 3, 0))
					entry.root.AssemblyLinearVelocity, entry.root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
				end
			end
		end
	end
	BotService:EndRound()
	cleanupMap()
	table.clear(contestants)
	table.clear(Round.StatsInfo)
	if winner then
		task.wait(5) -- finish showing the result before another round can start
	end
	music:FireAllClients("lobby")
	Round.RoundWinner = nil
	phase = "Idle"
end

function Round.RoundStart(chosen: Model): ()
	if phase ~= "Idle" then
		return
	end
	phase = "Preparing"
	generation += 1
	local token = generation
	Round.RoundWinner = nil
	local map = chosen:Clone()
	local spawnPoints: {BasePart} = {}
	for _, instance in map:GetDescendants() do
		if instance:IsA("BasePart") then
			if instance.Name == "SpawnPoint" then
				instance.CanCollide, instance.CanQuery, instance.Transparency = false, false, 1
				table.insert(spawnPoints, instance)
			elseif not CollectionService:HasTag(instance, "Indestructible") and instance:GetAttribute("Indestructible") ~= true then
				instance:SetAttribute("Destroyable", true)
				CollectionService:AddTag(instance, "RoundDestroyable") -- Shatterbox only cuts parts tagged for this round
			end
		end
	end
	if #spawnPoints == 0 then
		map:Destroy()
		notice("Map has no SpawnPoints; skipping round.")
		Round.RoundEnd()
		return
	end
	map.Parent = mapFolder
	local chosenEvent = Events.Events[rng:NextInteger(1, #Events.Events)]
	if chosen.Name == "Lava Rise" then
		for _, event in Events.Events do
			if event.Name == "None" then
				chosenEvent = event -- this map already has its own hazard script
			end
		end
	end
	announceMap(chosen, chosenEvent.Name)
	music:FireAllClients("none")
	task.wait(3)
	if generation ~= token then
		return
	end
	local used: {[BasePart]: boolean} = {}
	for _, player in Players:GetPlayers() do
		visible(ui(player, {"MapVote", "MapWinBg"}), false)
		local character = player.Character
		local root = if character then rootOf(character) else nil
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		if not character or character.Parent ~= dead or inPractice(character) or not root or not humanoid or humanoid.Health <= 0 then
			continue
		end
		if not equip(player, character, root) then
			warn("Round enrollment requires a valid owned ActiveGun:", player.Name)
			continue
		end
		local open: {BasePart} = {}
		for _, point in spawnPoints do
			if not used[point] then
				table.insert(open, point)
			end
		end
		local pool = if #open > 0 then open else spawnPoints
		local point = pool[rng:NextInteger(1, #pool)]
		used[point] = true
		Round.StatsInfo[player.Name] = snapshot(player)
		Cooldowns:ClearPlayer(player)
		for _, attribute in {"UsingSkill", "SkillDebounce", "Stunned", "Frozen", "Slowed"} do
			character:SetAttribute(attribute, false)
		end
		character:SetAttribute("Locked", true)
		character:PivotTo(point.CFrame * CFrame.new(0, 3, 0))
		root.AssemblyLinearVelocity, root.AssemblyAngularVelocity, root.Anchored = Vector3.zero, Vector3.zero, true
		character.Parent = alive
		local highlight = Instance.new("Highlight")
		highlight.Name, highlight.FillTransparency, highlight.OutlineTransparency, highlight.Parent = "GameHL", 1, 0.5, character
		register(character, player, token)
		roundRemote:FireClient(player, "RoundStart")
	end
	BotService:SpawnForRound(spawnPoints, used)
	for _, character in alive:GetChildren() do
		if character:IsA("Model") and character:GetAttribute("RoundBot") == true then
			register(character, nil, token)
		end
	end
	table.insert(connections, Players.PlayerRemoving:Connect(function(player: Player): ()
		local character = player.Character
		local entry = if character then contestants[character] else nil
		if entry then
			eliminate(entry, false) -- remove the leaving player without giving loss rewards
		end
	end))
	local killPlane = Workspace:FindFirstChild("KillForceField")
	if killPlane and killPlane:IsA("BasePart") then
		table.insert(connections, killPlane.Touched:Connect(function(hit: BasePart): ()
			local ancestor: Instance? = hit
			while ancestor and ancestor ~= Workspace do
				local entry = if ancestor:IsA("Model") then contestants[ancestor] else nil
				if entry then
					entry.humanoid.Health = 0
					return
				end
				ancestor = ancestor.Parent -- keep going up so weapon and accessory parts still find the character
			end
		end))
	end
	for count = 3, 1, -1 do
		if generation ~= token then
			return
		end
		for _, entry in contestants do
			entry.character:SetAttribute("Count", count)
		end
		local sound = SoundService:FindFirstChild("CountDown")
		if count == 3 and sound and sound:IsA("Sound") then
			sound:Play()
		end
		task.wait(1)
	end
	if generation ~= token then
		return
	end
	for _, entry in contestants do
		entry.root.Anchored = false
		entry.character:SetAttribute("Locked", false)
		entry.character:SetAttribute("Count", nil)
	end
	phase, Round.RoundActive = "Active", true
	BotService:UnlockRoundBots()
	local required = map:FindFirstChild("Required")
	if required and required:IsA("Script") then
		required.Enabled = true
	end
	Round.ActiveEventStop = chosenEvent.Fn(Round.RoundTime)
	music:FireAllClients("battle")
	local deadline, lastSecond, rising = os.clock() + Round.RoundTime, -1, false
	while generation == token and currentPhase() == "Active" do
		local living = survivors()
		if #living <= 1 then
			local winner = living[1]
			Round.RoundWinner = if winner then winner.player or winner.character else nil
			break
		end
		local remaining = math.max(0, math.ceil(deadline - os.clock()))
		if remaining ~= lastSecond then
			lastSecond = remaining
			notice(string.format("%d:%02d", math.floor(remaining / 60), remaining % 60))
		end
		if remaining == 0 then
			notice("Time ran out!")
			break -- more than one survivor at timeout means a draw
		end
		if not rising and remaining <= 30 and chosen.Name ~= "Lava Rise" and chosenEvent.Name ~= "Lava Drain" then
			rising = true
			Round.ActiveLavaStop = Events.StartRisingLava(remaining)
			for _, entry in living do
				if entry.player then
					roundRemote:FireClient(entry.player, "RisingLava")
				end
			end
		end
		task.wait(0.1) -- the deadline uses real elapsed time instead of counting waits
	end
	if generation == token then
		Round.RoundEnd()
	end
end

function Round.IntermissionStart(): ()
	if phase ~= "Idle" then
		return
	end
	phase = "Voting" -- reserve the intermission so another loop cannot start a second vote
	notice("Intermission...")
	for _, player in Players:GetPlayers() do
		roundRemote:FireClient(player, "skiesFIX")
	end
	task.wait(Round.IntermissionTime)
	notice("Voting...")
	Round.CanVote = true
	local chosen = Round.VoteStart()
	Round.CanVote = false
	phase = "Idle"
	if chosen then
		Round.RoundStart(chosen)
	else
		notice("No valid maps are configured.")
	end
end

return Round
