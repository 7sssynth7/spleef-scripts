local function EmitWinFX(WinnerChar)
	if not IsCharacterAliveAndValid(WinnerChar) then return end

	local WinFX = game.ReplicatedStorage.Assets.Fx.WinExp:Clone()
	WinFX.CFrame = WinnerChar.HumanoidRootPart.CFrame
	WinFX.Parent = workspace.Fx

	local listOfInstant = {}
	local listOfDelay = {}

	for _, emitter in pairs(WinFX:GetDescendants()) do
		if emitter:IsA("ParticleEmitter") then
			if emitter:GetAttribute("EmitDelay") then
				table.insert(listOfDelay, emitter)
			else
				table.insert(listOfInstant, emitter)
			end
		end
	end

	local closeWorks = game.ReplicatedStorage.Assets.Fx.Fireworks:Clone()
	closeWorks.Parent = WinnerChar

	local weld = Instance.new("Weld")
	weld.Part0 = WinnerChar.HumanoidRootPart
	weld.Part1 = closeWorks.Fireworks
	weld.Parent = closeWorks.Fireworks

	local weld2 = Instance.new("Weld")
	weld2.Part0 = WinnerChar.HumanoidRootPart
	weld2.Part1 = closeWorks.FireworksCopy
	weld2.Parent = closeWorks.FireworksCopy

	for _, particle in pairs(closeWorks:GetDescendants()) do
		if particle:IsA("ParticleEmitter") then
			particle:Emit(particle:GetAttribute("EmitCount"))
		end
	end

	local closefireworksfx = game.ReplicatedStorage.Assets.Sfx.Fireworks:Clone()
	closefireworksfx.Parent = WinnerChar.HumanoidRootPart
	closefireworksfx.Looped = true
	closefireworksfx:Play()

	game.Debris:AddItem(closefireworksfx, 3)
	game.Debris:AddItem(closeWorks, 3)

	for _ = 1, 3 do
		task.wait(1)
		if not IsCharacterAliveAndValid(WinnerChar) then break end
		WinFX.CFrame = WinnerChar.HumanoidRootPart.CFrame

		local shootSFX = game.ReplicatedStorage.Assets.Sfx.FireworkShoot:Clone()
		shootSFX.Parent = game.SoundService
		shootSFX.Volume = 2
		shootSFX:Play()
		game.Debris:AddItem(shootSFX, shootSFX.TimeLength)

		for _, emitter in listOfInstant do
			if emitter and emitter.Parent then
				emitter:Emit(emitter:GetAttribute("EmitCount"))
			end
		end

		for _, emitter in listOfDelay do
			task.delay(emitter:GetAttribute("EmitDelay"), function()
				if emitter and emitter.Parent then
					emitter:Emit(emitter:GetAttribute("EmitCount"))
				end
				local expSFX = game.ReplicatedStorage.Assets.Sfx.FireworkExplode:Clone()
				expSFX.Parent = game.SoundService
				expSFX.Volume = 1
				expSFX:Play()
				game.Debris:AddItem(expSFX, expSFX.TimeLength)
			end)
		end
	end

	game.Debris:AddItem(WinFX, 5)
end

local function killFeed(char, attacker)
	local feedTemplate = script.FeedTemplate
	local ti = TweenInfo.new(.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	for _, plr in game.Players:GetPlayers() do
		local ui = plr.PlayerGui:FindFirstChild("KillFeed")
		if not ui then continue end
		local cont = ui.FeedBg

		local newFeed = feedTemplate:Clone()
		newFeed.TextLabel.Text = char .. " Died to " .. attacker .. "!"

		newFeed.Parent = cont
		game.Debris:AddItem(newFeed, 3)
		newFeed.TextLabel.TextStrokeTransparency = 1
		newFeed.TextLabel.UIStroke.Transparency = 1
		newFeed.Skull.ImageTransparency = 1

		ts:Create(newFeed.TextLabel, ti, {TextTransparency = 0}):Play()
		ts:Create(newFeed.Skull, ti, {ImageTransparency = 0}):Play()
		ts:Create(newFeed.TextLabel.UIStroke, ti, {Transparency = 0}):Play()
	end
end

-- puts the player's chosen gun skin (texture + aura) on their gun
local function applySkin(player, gun)
	local activeSkin
	for _, skin in pairs(player.Skins:GetChildren()) do
		if skin.Active.Value == true then
			activeSkin = skin
			break
		end
	end

	if not activeSkin or activeSkin.Name == "Default" then return end

	local info = skinInfo.Skins[activeSkin.Name]
	if not info then
		warn("Skin not found in skininfo: " .. activeSkin.Name)
		return
	end
	local decalID = info.Icon

	local mesh = gun:FindFirstChildWhichIsA("SpecialMesh", true)
	if mesh then
		mesh.TextureId = decalID
	else
		for _, v in pairs(gun:GetDescendants()) do
			if v:IsA("BasePart") and v.Transparency ~= 1 then
				for _, face in {"Front", "Back", "Left", "Right", "Top", "Bottom"} do
					local decal = Instance.new("Decal", v)
					decal.Texture = decalID
					decal.Face = Enum.NormalId[face]
				end
			end
		end
	end

	local auraFolder = game.ReplicatedStorage.Assets.Fx.Skins:FindFirstChild(activeSkin.Name)
	if not auraFolder then
		warn("Gun Aura for: " .. activeSkin.Name .. " not found")
		return
	end

	local aura = auraFolder.Aura:Clone() :: Model

	local gunSize = gun:GetExtentsSize()
	local auraSize = aura:GetExtentsSize()
	local scale = math.max(gunSize.X, gunSize.Y, gunSize.Z) / math.max(auraSize.X, auraSize.Y, auraSize.Z)
	aura:ScaleTo(scale)

	aura.PrimaryPart.CFrame = gun.Point.CFrame
	aura.Parent = gun.Point

	local w = Instance.new("Weld", gun.Point)
	w.Part0 = gun.Point
	w.Part1 = aura.PrimaryPart
end

-- clones the player's active gun into their character and welds it to the arm
local function equipPlayerGun(player, char, hrp, WeaponsFolder)
	local activeGunVal = player:FindFirstChild("ActiveGun")
	if not activeGunVal or activeGunVal.Value == "" then return end
	if not player.Inventory:FindFirstChild(activeGunVal.Value) then return end

	for _, v in char:GetChildren() do
		if v:IsA("Model") and v:GetAttribute("Weapon") then
			v:Destroy()
		end
	end

	local gunTemplate = WeaponsFolder:FindFirstChild(activeGunVal.Value)
	if not gunTemplate then
		warn("Gun not found: " .. activeGunVal.Value)
		return
	end

	local chosenGun = gunTemplate:Clone() :: Model
	chosenGun.Parent = char
	chosenGun.PrimaryPart.CFrame = hrp.CFrame

	local motor = Instance.new("Motor6D")
	motor.Name = "WeaponMotor"
	motor.Part0 = char:FindFirstChild("Right Arm")
	motor.Part1 = chosenGun.PrimaryPart

	local chosenMotor = WeaponsFolder.Parent.Motors:FindFirstChild(activeGunVal.Value)
	if chosenMotor then
		motor.C0 = chosenMotor.C0
	end
	motor.Parent = chosenGun.PrimaryPart
	char:SetAttribute("EquippedWeapon", activeGunVal.Value)

	applySkin(player, chosenGun)
end

