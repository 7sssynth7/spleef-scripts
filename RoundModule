local LavaTargetSize = Vector3.new(723.2, 182.25, 459.7)
local LavaTargetPos = Vector3.new(130.8, 22.075, -351.05)
local LavaBottomY = LavaTargetPos.Y - (LavaTargetSize.Y / 2)

local suffixes = {"K", "M", "B", "T", "Qd", "Qn", "Sx", "Sp", "Oc", "No", "Dc"}

local function format(n)
	if n < 1000 then return tostring(n) end
	for i = #suffixes, 1, -1 do
		local threshold = 10 ^ (i * 3)
		if n >= threshold then
			local val = n / threshold
			local str = string.format(val < 10 and "%.2f" or val < 100 and "%.1f" or "%.0f", val)
			return str .. suffixes[i]
		end
	end
end

local function isLobbyPlayer(player)
	local character = player.Character
	return character and character:IsDescendantOf(DeadFolder)
end

local function StartRisingLava(duration)
	local lava = risingLava:Clone()
	lava.Anchored = true
	lava.Size = Vector3.new(LavaTargetSize.X, 0, LavaTargetSize.Z)
	lava.CFrame = CFrame.new(LavaTargetPos.X, LavaBottomY, LavaTargetPos.Z)
	lava.Parent = workspace.Fx

	local tween = ts:Create(lava, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = LavaTargetSize,
		Position = LavaTargetPos
	})
	tween:Play()

	return lava, tween
end

