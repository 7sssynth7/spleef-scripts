local ts = game:GetService("TweenService")
local Shatterbox = require(game.ReplicatedStorage.Modules.Shatterbox.Main)
local RunService = game:GetService("RunService")


local function getSpawnPoints(MeteorSpawns)
	local points = {}
	for _, v in ipairs(MeteorSpawns:GetDescendants()) do
		if v.Name == "MeteorSpawn" and v:IsA("BasePart") then
			table.insert(points, v)
		end
	end
	return points
end

local function filterValidSpawns(spawnPoints, raycastParams)
	local valid = {}
	for _, sp in ipairs(spawnPoints) do
		local result = workspace:Raycast(sp.Position, Vector3.new(0, -500, 0), raycastParams)
		if result then
			table.insert(valid, sp)
		else
			warn("Spawn over void, skipping: ", sp:GetFullName())
		end
	end
	return valid
end

local function DestroyNearbyUnions(hitPosition, radius)
	for _, part in ipairs(workspace:GetPartBoundsInRadius(hitPosition, radius)) do
		if part:IsA("UnionOperation") or part:IsA("MeshPart") and part:GetAttribute("Destroyable") then
			part:Destroy()
		end
	end
end

local function normExp(hitpos)
	local hb = Shatterbox.CreateHitbox()
	hb.Size = Vector3.one * 10
	hb.OnVoxelDestruct = "Destroy"
	hb.CleanupDelay = -1
	hb.CFrame = CFrame.new(hitpos)
	task.delay(.1, function()
		hb:DestroyHitbox()
	end)

	hb:Destroy()
end

local function DoMeteorExplosion(hitPosition, hitpart: Part)
	local explosionRadius = 10
	normExp(hitPosition)

	DestroyNearbyUnions(hitPosition, explosionRadius)

	task.spawn(function()
		local kbRadius, kb = 11, 50
		for _, p in workspace:GetDescendants() do
			if p:IsA("Model") and p:FindFirstChild("Humanoid") then
				local pChar = p
				if not pChar then continue end
				local hrp = pChar:FindFirstChild("HumanoidRootPart")
				if not hrp then continue end
				if (hrp.Position - hitPosition).Magnitude > kbRadius then continue end

				local knockDir = (hrp.Position - hitPosition)
				knockDir = knockDir.Magnitude > 0.1 and knockDir.Unit or Vector3.new(0, 1, 0)

				local existing = hrp:FindFirstChild("KnockbackVel")
				if existing then existing:Destroy() end

				local att = hrp:FindFirstChild("KnockbackAtt") or Instance.new("Attachment")
				att.Name = "KnockbackAtt"
				att.Parent = hrp

				local linVel = Instance.new("LinearVelocity")
				linVel.Name = "KnockbackVel"
				linVel.Attachment0 = att
				linVel.VectorVelocity = knockDir * kb
				linVel.MaxForce = math.huge
				linVel.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
				linVel.RelativeTo = Enum.ActuatorRelativeTo.World
				linVel.Parent = hrp
				game.Debris:AddItem(linVel, 0.15)
			end
		end
	end)

	local vfxExplode = game.ReplicatedStorage.Assets.Fx.Explosions.Default.Attachment:Clone()
	vfxExplode.Parent = workspace.Fx
	vfxExplode.Position = hitPosition
	task.spawn(function()
		wait()
		for _, v in pairs(vfxExplode:GetDescendants()) do
			if v:IsA("ParticleEmitter") then
				v:Emit(v:GetAttribute("EmitCount"))
			end
		end
	end)
	game.Debris:AddItem(vfxExplode, 2)

	local sfx = game.ReplicatedStorage.Assets.Sfx.MeteorImpact:Clone()
	sfx.Parent = vfxExplode
	sfx:Play()
	game.Debris:AddItem(sfx, sfx.TimeLength)
end


local function shootMeteor(activeMeteors, validSpawns, raycastParams)
	local MetIndicator = game.ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Fx"):WaitForChild("Indicator")
	local Meteor = game.ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Fx"):WaitForChild("Meteor")

	local warningTime = 3
	local spinSpeed = 180
	local indicatorMaxSize = 14
	local fallSpeed = 50

	local chosen = validSpawns[math.random(1, #validSpawns)]
	local spawnPos = chosen.Position

	local floorResult = workspace:Raycast(spawnPos, Vector3.new(0, -500, 0), raycastParams)
	if not floorResult then
		warn("Valid spawn lost its floor mid-event, skipping shot: ", chosen:GetFullName())
		return
	end
	local landPos = floorResult.Position
	local totalDist = spawnPos.Y - landPos.Y
	fallSpeed = totalDist / warningTime

	local indicator = MetIndicator:Clone()
	indicator.Anchored = true
	indicator.Size = Vector3.new(0.3, indicatorMaxSize, indicatorMaxSize)
	indicator.CFrame = CFrame.new(landPos.X, landPos.Y + 0.5, landPos.Z) * CFrame.Angles(0, 0, math.rad(90))
	indicator.Parent = workspace.Fx

	local meteorClone = Meteor:Clone()
	meteorClone:PivotTo(CFrame.new(spawnPos))
	meteorClone.Parent = workspace.Fx

	local meteorFallSFX = game.ReplicatedStorage.Assets.Sfx.MeteorFall:Clone()
	meteorFallSFX.Parent = meteorClone.PrimaryPart
	meteorFallSFX:Play()

	for _, part in ipairs(meteorClone:GetDescendants()) do
		if part:IsA("BasePart") then part.Anchored = true end
	end

	local function tweenMeteorTo(targetPos)
		local currentPos = meteorClone.PrimaryPart.Position
		local dist = currentPos.Y - targetPos.Y
		local duration = math.max(0.1, dist / fallSpeed)
		local delta = targetPos - currentPos
		for _, part in ipairs(meteorClone:GetDescendants()) do
			if part:IsA("BasePart") then
				ts:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
					Position = part.Position + delta
				}):Play()
			end
		end
	end

	tweenMeteorTo(landPos)

	local currentTarget = landPos
	local done = false
	local checkTimer = 0
	local spinConnection
	local cleanup

	cleanup = function()
		if done then return end
		done = true
		if spinConnection then spinConnection:Disconnect() end
		if indicator then indicator:Destroy() end
		if meteorClone then meteorClone:Destroy() end
		if meteorFallSFX then meteorFallSFX:Destroy() end
		if activeMeteors then activeMeteors[cleanup] = nil end
	end
	if activeMeteors then activeMeteors[cleanup] = true end

	spinConnection = RunService.Heartbeat:Connect(function(dt)
		if done then return end

		for _, part in ipairs(meteorClone:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CFrame = part.CFrame * CFrame.Angles(
					math.rad(spinSpeed * dt),
					math.rad(spinSpeed * dt * 0.7),
					math.rad(spinSpeed * dt * 0.3)
				)
			end
		end

		checkTimer += dt
		if checkTimer < 0.1 then return end
		checkTimer = 0

		local meteorPos = meteorClone.PrimaryPart.Position
		local rayOrigin = meteorPos + Vector3.new(0, 2, 0)
		local result = workspace:Raycast(rayOrigin, Vector3.new(0, -500, 0), raycastParams)

		if not result then
			print("destroy! (no floor)")
			cleanup()
			return
		end

		local newLandPos = result.Position
		local distToFloor = meteorPos.Y - newLandPos.Y

		if distToFloor <= 3 then
			DoMeteorExplosion(meteorClone.PrimaryPart.Position, result.Instance)
			cleanup()
			return
		end

		if (newLandPos - currentTarget).Magnitude > 2 then
			currentTarget = newLandPos
			tweenMeteorTo(newLandPos)
		end

		local sizeRatio = math.clamp(distToFloor / totalDist, 0, 1)
		local newSize = indicatorMaxSize * sizeRatio
		indicator.CFrame = CFrame.new(newLandPos.X, newLandPos.Y + 0.5, newLandPos.Z) * CFrame.Angles(0, 0, math.rad(90))
		indicator.Size = Vector3.new(0.3, newSize, newSize)
	end)

	task.delay(warningTime + 2, cleanup)
end

local function StartMeteorRain(dur)
	local running = true
	local startTime = os.clock()
	local activeMeteors = {}

	local MeteorSpawns = game.ReplicatedStorage.Assets.Fx.MeteorSpawns:Clone()
	MeteorSpawns.Parent = workspace.Map

	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = {workspace.Fx, workspace.Alive}
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude

	local allSpawns = getSpawnPoints(MeteorSpawns)
	local validSpawns = filterValidSpawns(allSpawns, raycastParams)

	if #validSpawns == 0 then
		warn("No valid meteor spawns found, skipping Meteor Shower")
		MeteorSpawns:Destroy()
		return function() end
	end

	task.spawn(function()
		while running and os.clock() - startTime < dur do
			shootMeteor(activeMeteors, validSpawns, raycastParams)
			task.wait(5)
		end
	end)

	return function()
		running = false
		for cleanupFn in pairs(activeMeteors) do
			cleanupFn()
		end
		MeteorSpawns:Destroy()
	end
end

