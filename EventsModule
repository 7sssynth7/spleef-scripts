local function shootLightning(activeStrikes, validSpawns, raycastParams)
	local chosen = validSpawns[math.random(1, #validSpawns)]
	local spawnPos = chosen.Position

	local floorResult = workspace:Raycast(spawnPos, Vector3.new(0, -500, 0), raycastParams)
	if not floorResult then
		warn("Valid spawn lost its floor mid-event, skipping strike: ", chosen:GetFullName())
		return
	end
	local landPos = floorResult.Position
	local dist = spawnPos.Y - landPos.Y

	local bolt = game.ReplicatedStorage.Assets.Fx.LightningBolt:Clone()
	bolt.Anchored = true
	bolt.CanCollide = false
	bolt.Size = Vector3.new(dist, bolt.Size.Y, bolt.Size.Z)
	bolt.CFrame = CFrame.new(landPos.X, landPos.Y + (dist / 2), landPos.Z) * CFrame.Angles(0, 0, math.rad(90))
	bolt.Parent = workspace.Fx
	bolt.Transparency = 1

	local thunderSFX = game.ReplicatedStorage.Assets.Sfx.ThunderStrike:Clone()
	thunderSFX.Parent = bolt
	thunderSFX:Play()

	DoLightningStrike(landPos, floorResult.Instance)

	local done = false
	local cleanup
	cleanup = function()
		if done then return end
		done = true
		if bolt then bolt:Destroy() end
		if activeStrikes then activeStrikes[cleanup] = nil end
	end
	if activeStrikes then activeStrikes[cleanup] = true end

	game.Debris:AddItem(thunderSFX, thunderSFX.TimeLength)
	task.delay(0.4, cleanup)
end

local function StartDescendingLava(risingLava, duration)
	local ti = TweenInfo.new(duration, Enum.EasingStyle.Linear)
	local lava = risingLava:Clone()
	lava.Anchored = true
	lava.Parent = workspace.Fx

	lava.Size = Vector3.new(lava.Size.X, 132, lava.Size.Z)
	lava.Position = Vector3.new(lava.Position.X, 3, lava.Position.Z)
	local tween = ts:Create(lava, ti, {
		Size = Vector3.new(lava.Size.X, 12, lava.Size.Z),
		Position = Vector3.new(lava.Position.X, -62, lava.Position.Z)
	})
	tween:Play()

	return lava, tween
end

