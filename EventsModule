local module = {}
module.Events = {
	{Name = "Lava Drain", Fn = function()
		print("lava drain event chosen!")

		local risingLava = game.ReplicatedStorage.Assets.Fx.RISINGLAVA
		local lava, tween = StartDescendingLava(risingLava, 150)

		for _, c in pairs(workspace.Alive:GetChildren()) do
			if c:IsA("Model") and c:FindFirstChild("Humanoid") then
				if game.Players:GetPlayerFromCharacter(c) then
					local plr = game.Players:GetPlayerFromCharacter(c)
					game.ReplicatedStorage.Remotes.RS:FireClient(plr, "RisingLava")
				end
			end
		end

		return function()
			if tween then tween:Cancel() end
			if lava then lava:Destroy() end
		end
	end},

	{Name = "Meteor Shower", Fn = function()
		print("meteor shower event chosen!")
		return StartMeteorRain(150)
	end},

	{Name = "Thunderstorm", Fn = function()
		print("thunderstorm event chosen!")
		return StartThunderstorm(150)
	end},
	
	{Name = "None", Fn = function()
		print("None event chosen!")
	end},

	{Name = "Windstorm", Fn = function()
		print("windstorm event chosen!")

		local dirs = {"Left", "Right", "Front", "Back"}
		local active = true
		local currentDirName = nil
		local currentDirPart = nil
		local oldWindFX = nil
		local pushDirection = Vector3.new(0, 0, 0)
		
		local windPushingSFX = game.ReplicatedStorage.Assets.Sfx.WindPushing:Clone()
		windPushingSFX.Parent = workspace.sounds
		windPushingSFX:Play()
		game.Debris:AddItem(windPushingSFX, 150)
		
		local dirVectors = {
			Front = Vector3.new(0, 0, -1),
			Back = Vector3.new(0, 0, 1),
			Left = Vector3.new(-1, 0, 0),
			Right = Vector3.new(1, 0, 0),
		}
		
		local function pickDir()
			local randDir
			repeat
				randDir = dirs[math.random(1, #dirs)]
			until randDir ~= currentDirName
			currentDirName = randDir

			local template = game.ReplicatedStorage.Assets.Fx:FindFirstChild("WindRel"..string.sub(randDir, 1, 1))
			if not template then warn("Missing wind asset for dir: "..randDir) return end

			if currentDirPart then
				currentDirPart:Destroy()
			end

			local clone = template:Clone()
			clone.Anchored = true
			clone.CanCollide = false
			clone.Parent = workspace.Fx
			currentDirPart = clone
			
			if oldWindFX then
				oldWindFX:Destroy()
				oldWindFX = nil
			end
			
			local newWindFX = game.ReplicatedStorage.Assets.Fx.WindFX:Clone()
			newWindFX.Parent = workspace.Fx
			newWindFX.CFrame = clone.CFrame * CFrame.new(0,0,-50)
			game:GetService("CollectionService"):AddTag(newWindFX, "Indestructible")
			
			oldWindFX = newWindFX

			pushDirection = dirVectors[randDir]
		end

		pickDir()

		local dirLoop = task.spawn(function()
			while active do
				task.wait(5)
				if active then pickDir() end
			end
		end)

		local forceLoop = task.spawn(function()
			while active do
				for _, char in pairs(workspace.Alive:GetChildren()) do
					if char:IsA("Model") then
						local hum = char:FindFirstChildOfClass("Humanoid")
						local hrp = char:FindFirstChild("HumanoidRootPart")
						if hum and hrp and hum.Health > 0 then
							local vf = hrp:FindFirstChild("WindForce")
							if hum.FloorMaterial ~= Enum.Material.Air then
								if not vf then
									local att = hrp:FindFirstChild("WindAtt") or Instance.new("Attachment")
									att.Name = "WindAtt"
									att.Parent = hrp
									vf = Instance.new("VectorForce")
									vf.Name = "WindForce"
									vf.Attachment0 = att
									vf.RelativeTo = Enum.ActuatorRelativeTo.World
									vf.Parent = hrp
								end
								if workspace.Map:FindFirstChildWhichIsA("Model").Name == "Ice Arena" then
									vf.Force = pushDirection * hrp.AssemblyMass * 75
								else
									vf.Force = pushDirection * hrp.AssemblyMass * 200
								end
							elseif vf then
								vf:Destroy()
							end
						end
					end
				end
				task.wait(0.1)
			end
		end)

		return function()
			active = false
			if currentDirPart then currentDirPart:Destroy() end
			for _, char in pairs(workspace.Alive:GetChildren()) do
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if hrp then
					local vf = hrp:FindFirstChild("WindForce")
					if vf then vf:Destroy() end
					local att = hrp:FindFirstChild("WindAtt")
					if att then att:Destroy() end
				end
			end
			
			if windPushingSFX then windPushingSFX:Destroy() end
			if oldWindFX then oldWindFX:Destroy() end
		end
	end},

	{Name = "Ice Ground", Fn = function()
		print("Ice Ground event chosen!")

		local active = true

		local function applyIce(part)
			if not part:IsA("BasePart") then return end
			part.Material = Enum.Material.Ice
			local existing = part.CustomPhysicalProperties
			part.CustomPhysicalProperties = PhysicalProperties.new(
				existing and existing.Density or part.CurrentPhysicalProperties.Density,
				0,
				existing and existing.Elasticity or part.CurrentPhysicalProperties.Elasticity,
				75,
				existing and existing.ElasticityWeight or part.CurrentPhysicalProperties.ElasticityWeight
			)
		end

		local currMap = workspace.Map:FindFirstChildWhichIsA("Model")

		local function sweep()
			if currMap then
				for _, part in pairs(currMap:GetDescendants()) do
					applyIce(part)
				end
			end
			for _, part in pairs(workspace.Debris:GetChildren()) do
				applyIce(part)
				for _, d in pairs(part:GetDescendants()) do
					applyIce(d)
				end
			end
		end

		sweep()

		local cons = {}
		if currMap then
			table.insert(cons, currMap.DescendantAdded:Connect(applyIce))
		end
		table.insert(cons, workspace.Debris.DescendantAdded:Connect(applyIce))

		task.spawn(function()
			while active do
				task.wait(1)
				if active then sweep() end
			end
		end)

		return function()
			active = false
			for _, c in pairs(cons) do
				c:Disconnect()
			end
		end
	end},
}
return module
