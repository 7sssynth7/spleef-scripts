local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")
type Stop = () -> ()
type Scope = {active: boolean, cleaners: {Stop}}
type Hitbox = {
	Size: Vector3, CFrame: CFrame, OnVoxelDestruct: string, CleanupDelay: number, FilterTagged: string,
	Destroy: (Hitbox) -> (), DestroyHitbox: (Hitbox) -> (),
}
export type Event = {Name: string, Fn: (number?) -> Stop}
local Shatterbox = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Shatterbox"):WaitForChild("Main"))
	:: {CreateHitbox: () -> Hitbox}
local assets = ReplicatedStorage:WaitForChild("Assets")
local fxAssets, sounds = assets:WaitForChild("Fx"), assets:WaitForChild("Sfx")
local alive, map, fx = Workspace:WaitForChild("Alive"), Workspace:WaitForChild("Map"), Workspace:WaitForChild("Fx")
local rng = Random.new()
local EventsModule = {}

local function stop(scope: Scope): ()
	if not scope.active then
		return -- cleanup can be called more than once
	end
	scope.active = false -- stop callbacks before destroying their objects
	for index = #scope.cleaners, 1, -1 do
		local ok, reason = pcall(function(): nil
			scope.cleaners[index]()
			return nil
		end)
		if not ok then
			warn("Hazard cleanup failed:", reason) -- keep cleaning up if one resource fails
		end
	end
	table.clear(scope.cleaners)
end

local function own(scope: Scope, instance: Instance): ()
	table.insert(scope.cleaners, function(): ()
		instance:Destroy()
	end)
end

local function run(scope: Scope, duration: number, step: (number, number) -> ()): Stop
	local elapsed = 0
	local updating = false
	local connection = RunService.Heartbeat:Connect(function(dt: number): ()
		if not scope.active then
			return
		end
		elapsed += dt
		if elapsed >= duration then
			stop(scope)
			return
		end
		if updating then
			return -- wait for the current update if a dependency yields
		end
		updating = true
		local ok, reason = pcall(function(): nil
			step(dt, elapsed)
			return nil
		end)
		updating = false
		if not ok then
			warn("Hazard stopped after an update error:", reason)
			stop(scope) -- remove the hazard if its update fails
		end
	end)
	table.insert(scope.cleaners, function(): ()
		connection:Disconnect()
	end)
	return function(): ()
		stop(scope)
	end
end

local function liveRoot(character: Instance): (BasePart?, Humanoid?)
	if not character:IsA("Model") then
		return nil, nil
	end
	local root, humanoid = character:FindFirstChild("HumanoidRootPart"), character:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
		return root, humanoid
	end
	return nil, nil
end

local function emit(instance: Instance): ()
	for _, child in instance:GetDescendants() do
		if child:IsA("ParticleEmitter") then
			local count = child:GetAttribute("EmitCount")
			child:Emit(if typeof(count) == "number" then math.clamp(count, 0, 1000) else 15)
		end
	end
end

local function playSound(name: string, parent: Instance): ()
	local template = sounds:FindFirstChild(name)
	if template and template:IsA("Sound") then
		local sound = template:Clone()
		sound.Parent = parent -- spatial sound needs a part or attachment
		sound:Play()
		Debris:AddItem(sound, 10) -- TimeLength can still be zero while the sound loads
	end
end

local function impact(scope: Scope, position: Vector3, lightning: boolean): ()
	if not scope.active then
		return
	end
	local hitbox = Shatterbox.CreateHitbox()
	hitbox.Size, hitbox.CFrame = Vector3.one * 10, CFrame.new(position)
	hitbox.OnVoxelDestruct, hitbox.CleanupDelay = "Destroy", -1
	hitbox.FilterTagged = "RoundDestroyable" -- only destroy tagged parts from this round
	hitbox:Destroy() -- Destroy runs the cut, DestroyHitbox cleans up the hitbox
	task.delay(0.1, function(): ()
		hitbox:DestroyHitbox() -- give the queued cut time before cleanup
	end)
	if not scope.active then
		return -- the round may have ended while destruction yielded
	end
	local overlap = OverlapParams.new()
	overlap.FilterType, overlap.FilterDescendantsInstances = Enum.RaycastFilterType.Include, {map}
	for _, part in Workspace:GetPartBoundsInRadius(position, 10, overlap) do
		if (part:IsA("UnionOperation") or part:IsA("MeshPart")) and part:GetAttribute("Destroyable") == true then
			part:Destroy() -- both unions and meshes must have Destroyable set
		end
	end
	for _, character in alive:GetChildren() do
		local root = liveRoot(character)
		if root and not root.Anchored then
			local offset = root.Position - position
			local radius = if lightning then 9 else 11
			if offset.Magnitude <= radius then
				local direction = if offset.Magnitude > 0.1 then offset.Unit else Vector3.yAxis
				root:ApplyImpulse((direction + Vector3.yAxis * 0.3).Unit * root.AssemblyMass * (if lightning then 40 else 50))
			end
		end
	end
	local anchor = Instance.new("Part")
	anchor.Name, anchor.Size, anchor.CFrame = "HazardImpact", Vector3.one, CFrame.new(position)
	anchor.Anchored, anchor.CanCollide, anchor.CanTouch, anchor.CanQuery = true, false, false, false
	anchor.Transparency, anchor.Parent = 1, fx
	own(scope, anchor)
	local template = if lightning then fxAssets:FindFirstChild("ThunderStrikeModel") else nil
	if not lightning then
		local explosions = fxAssets:FindFirstChild("Explosions")
		local default = if explosions then explosions:FindFirstChild("Default") else nil
		template = if default then default:FindFirstChild("Attachment") else nil
	end
	if template then
		local effect = template:Clone()
		if effect:IsA("Model") then
			effect:PivotTo(CFrame.new(position + Vector3.yAxis * 55))
		elseif effect:IsA("BasePart") then
			effect.CFrame = CFrame.new(position)
		end
		effect.Parent = anchor
		emit(effect) -- the attachment gets its world position from the anchor
	end
	playSound(if lightning then "ThunderStrike" else "MeteorImpact", anchor)
	Debris:AddItem(anchor, 5)
end

local function weatherPoints(): {Vector3}
	local points: {Vector3} = {}
	local folder = fxAssets:FindFirstChild("MeteorSpawns")
	if folder then
		for _, child in folder:GetDescendants() do
			if child:IsA("BasePart") and child.Name == "MeteorSpawn" then
				table.insert(points, child.Position) -- read the markers without cloning the whole folder
			end
		end
	end
	return points
end

local function mapRays(): RaycastParams
	local params = RaycastParams.new()
	params.FilterType, params.FilterDescendantsInstances = Enum.RaycastFilterType.Include, {map}
	params.RespectCanCollide = true -- noncollidable parts cannot count as a landing surface
	return params
end

local function startWeather(lightning: boolean, duration: number): Stop
	local scope: Scope = {active = true, cleaners = {}}
	local points, rays = weatherPoints(), mapRays()
	type Meteor = {model: Model, indicator: BasePart, position: Vector3, speed: number, age: number}
	local meteors: {Meteor} = {}
	table.insert(scope.cleaners, function(): ()
		for _, meteor in meteors do
			meteor.model:Destroy()
			meteor.indicator:Destroy()
		end
		table.clear(meteors)
	end)
	local sinceShot, sinceProbe = 10, 0
	return run(scope, duration, function(dt: number, elapsed: number): ()
		sinceShot += dt
		if #points > 0 and sinceShot >= (if lightning then 2 else 5) then
			sinceShot = 0
			local origin = points[rng:NextInteger(1, #points)]
			local floor = Workspace:Raycast(origin, -Vector3.yAxis * 500, rays)
			if floor and lightning then
				impact(scope, floor.Position, true)
				if not scope.active then return end
				local bolt = fxAssets:FindFirstChild("LightningBolt")
				if bolt and bolt:IsA("BasePart") then
					local clone = bolt:Clone()
					local height = (origin - floor.Position).Magnitude
					clone.Size = Vector3.new(height, clone.Size.Y, clone.Size.Z)
					clone.CFrame = CFrame.new((origin + floor.Position) * 0.5) * CFrame.Angles(0, 0, math.pi / 2)
					clone.Anchored, clone.CanCollide, clone.CanQuery, clone.Parent = true, false, false, fx
					Debris:AddItem(clone, 0.4)
				end
			elseif floor then
				local meteorTemplate, indicatorTemplate = fxAssets:FindFirstChild("Meteor"), fxAssets:FindFirstChild("Indicator")
				if meteorTemplate and meteorTemplate:IsA("Model") and indicatorTemplate and indicatorTemplate:IsA("BasePart") then
					local model, indicator = meteorTemplate:Clone(), indicatorTemplate:Clone()
					for _, part in model:GetDescendants() do
						if part:IsA("BasePart") then
							part.Anchored, part.CanCollide, part.CanQuery = true, false, false
						end
					end
					model:PivotTo(CFrame.new(origin))
					model.Parent = fx
					indicator.Anchored, indicator.CanCollide, indicator.CanQuery, indicator.Parent = true, false, false, fx
					indicator.CFrame = CFrame.new(floor.Position + Vector3.yAxis * 0.5) * CFrame.Angles(0, 0, math.pi / 2)
					indicator.Size = Vector3.new(0.3, 14, 14)
					local primary = model.PrimaryPart
					if primary then
						playSound("MeteorFall", primary)
					end
					table.insert(meteors, {model = model, indicator = indicator, position = origin,
						speed = math.max(10, (origin.Y - floor.Position.Y) / 3), age = 0})
				end
			end
		end
		sinceProbe += dt
		if sinceProbe < 0.1 then
			return -- limit the warning and floor checks to ten updates per second
		end
		local step = sinceProbe
		sinceProbe = 0
		for index = #meteors, 1, -1 do
			local meteor = meteors[index]
			local travel = meteor.speed * step
			local hit = Workspace:Raycast(meteor.position, -Vector3.yAxis * (travel + 2), rays)
			meteor.age += step
			if hit or meteor.age > 12 or meteor.model.Parent == nil then
				if hit then
					impact(scope, hit.Position, false) -- check the full travel distance so lag cannot skip the floor
					if not scope.active then return end
				end
				meteor.model:Destroy()
				meteor.indicator:Destroy()
				table.remove(meteors, index)
			else
				meteor.position -= Vector3.yAxis * travel
				meteor.model:PivotTo(CFrame.new(meteor.position) * CFrame.Angles(elapsed * 3, elapsed * 2, elapsed))
				local floor = Workspace:Raycast(meteor.position, -Vector3.yAxis * 500, rays)
				if floor then
					meteor.indicator.CFrame = CFrame.new(floor.Position + Vector3.yAxis * 0.5) * CFrame.Angles(0, 0, math.pi / 2)
					local size = math.max(0.2, 14 * math.clamp((meteor.position.Y - floor.Position.Y) / (meteor.speed * 3), 0, 1))
					meteor.indicator.Size = Vector3.new(0.3, size, size)
				else
					meteor.model:Destroy()
					meteor.indicator:Destroy()
					table.remove(meteors, index) -- remove the warning if its floor is gone
				end
			end
		end
	end)
end

local function lavaHazard(duration: number, draining: boolean): Stop
	local scope: Scope = {active = true, cleaners = {}}
	local template = fxAssets:WaitForChild("RISINGLAVA")
	assert(template:IsA("BasePart"), "RISINGLAVA must be a BasePart")
	local lava = template:Clone()
	lava.Anchored, lava.CanCollide, lava.CanQuery = true, false, false
	local targetSize, targetPosition = Vector3.new(723.2, 182.25, 459.7), Vector3.new(130.8, 22.075, -351.05)
	local bottom = targetPosition.Y - targetSize.Y * 0.5
	lava.Size = if draining then Vector3.new(targetSize.X, 132, targetSize.Z) else Vector3.new(targetSize.X, 0.1, targetSize.Z)
	lava.Position = if draining then Vector3.new(targetPosition.X, bottom + 66, targetPosition.Z)
		else Vector3.new(targetPosition.X, bottom + 0.05, targetPosition.Z)
	lava.Parent = fx
	own(scope, lava)
	local goal = if draining then {Size = Vector3.new(targetSize.X, 0.1, targetSize.Z), Position = Vector3.new(targetPosition.X, bottom, targetPosition.Z)}
		else {Size = targetSize, Position = targetPosition}
	local tween = TweenService:Create(lava, TweenInfo.new(duration, Enum.EasingStyle.Linear), goal)
	tween:Play()
	table.insert(scope.cleaners, function(): ()
		tween:Cancel() -- cancel the tween before destroying the lava
	end)
	local timer = 0
	return run(scope, duration, function(dt: number, _elapsed: number): ()
		timer += dt
		if timer < 0.1 then
			return
		end
		timer = 0
		for _, character in alive:GetChildren() do
			local root, humanoid = liveRoot(character)
			if root and humanoid then
				local point = lava.CFrame:PointToObjectSpace(root.Position) -- local coordinates make the check match the lava volume
				local half = lava.Size * 0.5
				if math.abs(point.X) <= half.X and math.abs(point.Z) <= half.Z and point.Y <= half.Y and point.Y >= -half.Y then
					humanoid.Health = 0 -- growing lava can miss touch events, so check it on the server
				end
			end
		end
	end)
end

local function windstorm(duration: number): Stop
	local scope: Scope = {active = true, cleaners = {}}
	type Wind = {force: VectorForce, attachment: Attachment}
	local forces: {[BasePart]: Wind} = {}
	table.insert(scope.cleaners, function(): ()
		fx:SetAttribute("WindDirection", nil)
	end)
	table.insert(scope.cleaners, function(): ()
		for _, entry in forces do
			entry.force:Destroy()
			entry.attachment:Destroy() -- also clean attachments from fighters who already left Alive
		end
		table.clear(forces)
	end)
	local direction, directionIndex, timer = Vector3.xAxis, 0, 5
	local directions = {Vector3.xAxis, -Vector3.xAxis, Vector3.zAxis, -Vector3.zAxis}
	local accumulator = 0
	return run(scope, duration, function(dt: number, _elapsed: number): ()
		timer += dt
		if timer >= 5 then
			timer = 0
			directionIndex = (directionIndex + rng:NextInteger(1, 3) - 1) % 4 + 1 -- pick one of the other three directions
			direction = directions[directionIndex]
			fx:SetAttribute("WindDirection", direction) -- clients can use this direction for wind effects
		end
		accumulator += dt
		if accumulator < 0.1 then
			return
		end
		accumulator = 0
		local present: {[BasePart]: boolean} = {}
		for _, character in alive:GetChildren() do
			local root, humanoid = liveRoot(character)
			if root and humanoid and not root.Anchored and humanoid.FloorMaterial ~= Enum.Material.Air then
				present[root] = true
				local entry = forces[root]
				if not entry then
					local attachment, force = Instance.new("Attachment"), Instance.new("VectorForce")
					attachment.Parent = root
					force.Attachment0, force.RelativeTo, force.ApplyAtCenterOfMass = attachment, Enum.ActuatorRelativeTo.World, true
					force.Parent = root
					entry = {force = force, attachment = attachment}
					forces[root] = entry
				end
				local currentMap = map:FindFirstChildWhichIsA("Model")
				local acceleration = if currentMap and currentMap.Name == "Ice Arena" then 75 else 200
				entry.force.Force = direction * root.AssemblyMass * acceleration -- mass scaling gives different rigs the same acceleration
			end
		end
		for root, entry in forces do
			if not present[root] then
				entry.force:Destroy()
				entry.attachment:Destroy()
				forces[root] = nil
			end
		end
	end)
end

local function iceGround(duration: number): Stop
	local scope: Scope = {active = true, cleaners = {}}
	type Original = {material: Enum.Material, physics: PhysicalProperties?}
	local originals: {[BasePart]: Original} = {}
	local function apply(instance: Instance): ()
		if not instance:IsA("BasePart") or originals[instance] then
			return
		end
		originals[instance] = {material = instance.Material, physics = instance.CustomPhysicalProperties}
		local physics = instance.CurrentPhysicalProperties
		instance.Material = Enum.Material.Ice
		instance.CustomPhysicalProperties = PhysicalProperties.new(physics.Density, 0, physics.Elasticity, 100, physics.ElasticityWeight)
	end
	table.insert(scope.cleaners, function(): ()
		for part, original in originals do
			if part.Parent then
				part.Material = original.material
				local writable = part :: any -- nil restores default physics but the generated type leaves it out
				writable.CustomPhysicalProperties = original.physics
			end
		end
		table.clear(originals)
	end)
	local containers: {Instance} = {map}
	local debris = Workspace:FindFirstChild("Debris")
	if debris then
		table.insert(containers, debris)
	end
	for _, container in containers do
		for _, child in container:GetDescendants() do
			apply(child)
		end
		local connection = container.DescendantAdded:Connect(apply) -- apply ice when new debris is added instead of scanning it again
		table.insert(scope.cleaners, function(): ()
			connection:Disconnect()
		end)
	end
	return run(scope, duration, function(_dt: number, _elapsed: number): () end)
end

function EventsModule.StartRisingLava(duration: number): Stop
	return lavaHazard(duration, false)
end

EventsModule.Events = {
	{Name = "Lava Drain", Fn = function(duration: number?): Stop return lavaHazard(duration or 150, true) end},
	{Name = "Meteor Shower", Fn = function(duration: number?): Stop return startWeather(false, duration or 150) end},
	{Name = "Thunderstorm", Fn = function(duration: number?): Stop return startWeather(true, duration or 150) end},
	{Name = "None", Fn = function(_duration: number?): Stop return function(): () end end},
	{Name = "Windstorm", Fn = function(duration: number?): Stop return windstorm(duration or 150) end},
	{Name = "Ice Ground", Fn = function(duration: number?): Stop return iceGround(duration or 150) end},
} :: {Event}

return EventsModule
